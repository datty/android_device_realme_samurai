type hal_engsensor_hwservice, hwservice_manager_type;
# HIDL fingerprintpay@1.0 (AIDL path uses oplus service_contexts)
type hal_fingerprintpay_hwservice, hwservice_manager_type;
type hal_nxpnfc_hwservice, hwservice_manager_type;
