        android:key="charging_speed"
        android:title="@string/charging_speed_pref_title"
        android:summary="%s"
        android:dialogTitle="@string/charging_speed_dialog_title"
        android:entries="@array/charging_speed_entries"
        android:entryValues="@array/charging_speed_values"
        android:defaultValue="0" />

</PreferenceScreen>
