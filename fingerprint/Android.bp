// Device-local fingerprint HAL wrapper for samurai (Realme X2 Pro).
// Uses sysfs-based HBM control (/sys/kernel/oppo_display/dimlayer_hbm) and
// the syshelper AIDL service for UDFPS touch signalling, as required by the
// oppo_display kernel driver on this device (hardware/oplus uses
// /dev/oplus_display ioctls which do not exist on samurai).

cc_binary {
    name: "android.hardware.biometrics.fingerprint@2.3-service.samurai",
    defaults: ["hidl_defaults"],
    init_rc: ["android.hardware.biometrics.fingerprint@2.3-service.samurai.rc"],
    vintf_fragments: ["android.hardware.biometrics.fingerprint@2.3-service.samurai.xml"],
    vendor: true,
    relative_install_path: "hw",
    srcs: [
        "BiometricsFingerprint.cpp",
        "service.cpp",
    ],
    shared_libs: [
        "libbase",
        "libbinder_ndk",
        "libhidlbase",
        "libutils",
        "android.hardware.biometrics.fingerprint@2.1",
        "android.hardware.biometrics.fingerprint@2.2",
        "android.hardware.biometrics.fingerprint@2.3",
        "vendor.oplus.hardware.biometrics.fingerprint@2.1",
        "vendor.oplus.hardware.syshelper-V1-ndk",
    ],
}

// Static UDFPS z-order extension linked into SurfaceFlinger.
// Wired via: soong_config_set surfaceflinger udfps_lib
//            //device/realme/samurai/fingerprint:libudfps_extension.samurai
cc_library_static {
    name: "libudfps_extension.samurai",
    srcs: ["UdfpsExtension.cpp"],
    include_dirs: [
        "frameworks/native/services/surfaceflinger/CompositionEngine/include",
    ],
    header_libs: [
        "generated_kernel_headers",
    ],
}
