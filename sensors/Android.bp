// The sensors multihal service is provided by the AOSP
// android.hardware.sensors@2.1-service.multihal (referenced from device.mk and
// also pulled by the common config). This device only contributes the OPLUS
// sensor subhal below, loaded by the multihal via configs/sensors/hals.conf.
//
// The previous inline custom multihal service (service.cpp / HalProxy* /
// AlsCorrection.cpp) installed the same vendor/bin/hw/...service.multihal binary
// as the AOSP one, which is unconditionally built on lineage-23 -> dupbuild
// collision. It is no longer built; its sources remain for reference. The inline
// ALS correction is dropped here and can be reintroduced as a subhal-side
// adjustment later if needed.

cc_library_shared {
    name: "sensors.oplus.samurai",
    defaults: ["hidl_defaults"],
    srcs: [
        "Sensor.cpp",
        "SensorsSubHal.cpp",
    ],
    shared_libs: [
        "android.hardware.sensors@1.0",
        "android.hardware.sensors@2.0",
        "android.hardware.sensors@2.0-ScopedWakelock",
        "android.hardware.sensors@2.1",
        "libcutils",
        "libfmq",
        "libhardware",
        "libhidlbase",
        "liblog",
        "libpower",
        "libutils",
    ],
    static_libs: [
        "android.hardware.sensors@1.0-convert",
        "android.hardware.sensors@2.X-multihal",
    ],
    cflags: [
        "-DLOG_TAG=\"sensors.oplus\"",
    ],
    vendor: true,
}
